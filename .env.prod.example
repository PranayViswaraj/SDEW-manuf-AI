# PRODUCTION settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Public hostname of the ManufAI site (Caddy fetches the HTTPS certificate for it).
# Use :80 for plain HTTP on a private network only.
MANUFAI_DOMAIN=manufai.example.com
MANUFAI_CORS_ORIGINS=https://manufai.example.com

MANUFAI_JWT_SECRET=
POSTGRES_USER=manufai
POSTGRES_PASSWORD=
POSTGRES_DB=manufai

MANUFAI_LOG_LEVEL=INFO
# Turn on to browse the API at https://<domain>/docs (off by default in production).
MANUFAI_DOCS_ENABLED=false
# Strict-Transport-Security; set false only when serving plain HTTP.
MANUFAI_HSTS=true
