# ManufAI settings. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------
# Server
MANUFAI_ENV=dev
# SQLite for local dev (no Docker):
MANUFAI_DATABASE_URL=sqlite:///./manufai.db
# PostgreSQL (docker compose overrides this automatically):
# MANUFAI_DATABASE_URL=postgresql+psycopg://manufai:manufai@localhost:5432/manufai
MANUFAI_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
MANUFAI_JWT_EXPIRE_MINUTES=480
# Demo mode: dev users with the public passwords from the README, SIM Lathe and sample data.
# Off by default. NEVER true in production.
MANUFAI_SEED_DEV_DATA=false
MANUFAI_CORS_ORIGINS=http://localhost:5173
# Status shows stale/offline in the UI after this many seconds without updates (safety rule 8).
MANUFAI_STATUS_STALE_SECONDS=5
# Commands older than this are rejected by the bridge.
MANUFAI_COMMAND_MAX_AGE_SECONDS=10

# Postgres container (docker compose only)
POSTGRES_USER=manufai
POSTGRES_PASSWORD=manufai
POSTGRES_DB=manufai
POSTGRES_PORT=5432

# Ports
SERVER_PORT=8000
WEB_PORT=5173

# Web (Vite dev server proxies /api to this)
VITE_API_PROXY_TARGET=http://localhost:8000
